{
  "game": "clobber_2x2",
  "positions": [
    {
      "comment": "starting position, first player: each piece can take either neighbour",
      "position": [1, 2, 2, 1],
      "side_to_move": 0,
      "expected_moves": [
        [0, 1, 2, 1],
        [0, 2, 1, 1],
        [1, 1, 2, 0],
        [1, 2, 1, 0]
      ],
      "expected_result": null
    },
    {
      "comment": "starting position, second player: the same four moves mirrored",
      "position": [1, 2, 2, 1],
      "side_to_move": 1,
      "expected_moves": [
        [2, 0, 2, 1],
        [1, 0, 2, 2],
        [2, 2, 0, 1],
        [1, 2, 0, 2]
      ],
      "expected_result": null
    },
    {
      "comment": "one colour left: nothing to clobber, so the player to move has lost",
      "position": [1, 1, 1, 1],
      "side_to_move": 0,
      "expected_moves": [],
      "expected_result": -1
    },
    {
      "comment": "and the same board from the other side, which has no pieces at all",
      "position": [1, 1, 1, 1],
      "side_to_move": 1,
      "expected_moves": [],
      "expected_result": -1
    },
    {
      "comment": "both colours present but only diagonally adjacent, so neither can move",
      "position": [1, 0, 0, 2],
      "side_to_move": 0,
      "expected_moves": [],
      "expected_result": -1
    },
    {
      "comment": "one capture available, and it empties the square moved from",
      "position": [1, 2, 0, 0],
      "side_to_move": 0,
      "expected_moves": [
        [0, 1, 0, 0]
      ],
      "expected_result": null
    },
    {
      "comment": "the same board the other way round",
      "position": [1, 2, 0, 0],
      "side_to_move": 1,
      "expected_moves": [
        [2, 0, 0, 0]
      ],
      "expected_result": null
    }
  ]
}
