{
  "game": "normalnim_3x3",
  "tests": [
    {
      "type": "validate",
      "comment": "three full heaps: every heap can be reduced to anything smaller",
      "position": [3, 3, 3],
      "side_to_move": 0,
      "expected_moves": [
        [0, 3, 3],
        [1, 3, 3],
        [2, 3, 3],
        [3, 0, 3],
        [3, 1, 3],
        [3, 2, 3],
        [3, 3, 0],
        [3, 3, 1],
        [3, 3, 2]
      ],
      "expected_result": null
    },
    {
      "type": "validate",
      "comment": "both sides always have the same moves, so the second player sees those nine too",
      "position": [3, 3, 3],
      "side_to_move": 1,
      "expected_moves": [
        [0, 3, 3],
        [1, 3, 3],
        [2, 3, 3],
        [3, 0, 3],
        [3, 1, 3],
        [3, 2, 3],
        [3, 3, 0],
        [3, 3, 1],
        [3, 3, 2]
      ],
      "expected_result": null
    },
    {
      "type": "validate",
      "comment": "all heaps empty: normal play, so the player to move has lost",
      "position": [0, 0, 0],
      "side_to_move": 0,
      "expected_moves": [],
      "expected_result": -1
    },
    {
      "type": "validate",
      "comment": "and the same for the other side",
      "position": [0, 0, 0],
      "side_to_move": 1,
      "expected_moves": [],
      "expected_result": -1
    },
    {
      "type": "validate",
      "comment": "empty heaps offer nothing; only the one with tokens can be taken from",
      "position": [0, 2, 0],
      "side_to_move": 1,
      "expected_moves": [
        [0, 0, 0],
        [0, 1, 0]
      ],
      "expected_result": null
    },
    {
      "type": "validate",
      "comment": "a single token left in each of two heaps",
      "position": [1, 0, 1],
      "side_to_move": 0,
      "expected_moves": [
        [0, 0, 1],
        [1, 0, 0]
      ],
      "expected_result": null
    }
  ]
}
